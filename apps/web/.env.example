# =============================================================================
# Notes Platform — Environment Variables Reference (.env.example)
# Copy this file to .env.local and configure your preferred email provider.
# =============================================================================

# ── Phone.email Authentication ──────────────────────────────────────────────
# "Sign in with Phone" tab (Phone OTP via Phone.email)
NEXT_PUBLIC_PHONE_EMAIL_PHONE_CLIENT_ID=13808886644709808956

# ── Email OTP Delivery (Configure at least ONE to send real emails) ──────────

# OPTION A: Brevo API (Recommended: Free 300 emails/day)
# Get your API key at: https://app.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your-verified-sender@example.com

# OPTION B: Resend API (Free 3,000 emails/month)
# Get your API key at: https://resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_SENDER_EMAIL=onboarding@resend.dev

# OPTION C: Gmail SMTP (Send directly from your Gmail account)
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# (Note: If none of A, B, or C is set, OTP codes are logged to the terminal in Dev Mode)

# ── Auth Settings ───────────────────────────────────────────────────────────
SIGNUP_MODE=allowlist
NEXT_PUBLIC_SIGNUP_MODE=allowlist
AUTH_PROVIDER=email-otp-brevo

# ── JWT Session Secret (min 32 chars) ───────────────────────────────────────
JWT_SECRET=super_secret_session_encryption_key_at_least_32_chars_long

# ── Administrator Credentials ────────────────────────────────────────────────
ADMIN_USERNAME=note@admin
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_IDENTIFIERS=note@admin,sayandipdey57@gmail.com,deysayandip02@gmail.com

# ── Rate Limiting (optional) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
